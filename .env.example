# ==========================================
# PrepPulse Environment Configuration Template
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Python AI Microservice Interop
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_PORT=8001
INTERNAL_SERVICE_SECRET=preppulse-internal-ai-service-secret-token-key-32chars

# AI & LLM Provider (Groq API)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB Database Configuration
# Use local MongoDB (mongodb://localhost:27017) or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=preppulse_db
# Set to true to allow in-memory mock fallback in development when live MongoDB is offline
ALLOW_MOCK_DB=true

# Cryptographic Authentication (Argon2id & JWT)
# Generate a secret key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_secure_hex_key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS & Security Gateways
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=60
